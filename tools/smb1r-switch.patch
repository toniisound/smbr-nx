+# Switch: "LOADING..." over the black transition block while the next scene
+# loads (scene loads block the main thread for a while on the console), so the
+# game doesn't look frozen. Added from code to keep the scene file untouched.
+var loading_label: Label = null
+
+func _setup_loading_label() -> void:
+	loading_label = Label.new()
+	loading_label.name = "LoadingLabel"
+	loading_label.text = "LOADING..."
+	loading_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	loading_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	loading_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	loading_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	loading_label.hide()
+	$Transition.add_child(loading_label) # last child: drawn above TransitionBlock
+
